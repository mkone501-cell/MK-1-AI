# 本番設定項目のダミー値です。このファイル自体を本番設定として使いません。
NODE_ENV=production
PORT=8000
SESSION_STORE=database
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
ALLOWED_ORIGINS=https://your-mk1-frontend.example.invalid
MK1_OWNER_EMAIL=owner@example.invalid
MK1_OWNER_PASSWORD_HASH=replace-with-generated-scrypt-hash
OPENAI_API_KEY=replace-with-server-secret
OPENAI_MODEL=gpt-5-mini
DATABASE_URL=postgresql://dummy-user:dummy-password@db.example.invalid:5432/dummy-db
